<?xml version="1.0" encoding="utf-8"?>
<!-- Estado vazio reutilizável: ícone + mensagem + ação opcional -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/margem_tela"
    android:visibility="gone">

    <ImageView
        android:id="@+id/imgVazio"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:alpha="0.6"
        android:importantForAccessibility="no"
        app:tint="@color/verde_primario" />

    <TextView
        android:id="@+id/txtVazio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_medio"
        android:gravity="center"
        android:textAppearance="@style/Texto.Secundario" />

    <Button
        android:id="@+id/btnVazio"
        style="@style/Botao.Principal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_medio"
        android:visibility="gone" />
</LinearLayout>
