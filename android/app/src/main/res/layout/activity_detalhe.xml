<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    <ProgressBar
        android:id="@+id/progresso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espaco_medio">

            <TextView
                android:id="@+id/txtData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:textAppearance="@style/Texto.Secundario" />

            <include
                android:id="@+id/plano"
                layout="@layout/layout_plano_completo" />

            <!-- Anotações: edição via PATCH -->
            <androidx.cardview.widget.CardView
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detalhe_anotacoes"
                        android:textAppearance="@style/Texto.Secao" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/CampoTexto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/detalhe_observacao"
                        app:counterEnabled="true"
                        app:counterMaxLength="500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtObservacao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="500"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swFavorita"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:text="@string/detalhe_favorita" />

                    <Button
                        android:id="@+id/btnSalvar"
                        style="@style/Botao.Principal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:text="@string/detalhe_salvar" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnCompartilhar"
                style="@style/Botao.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:text="@string/resultado_compartilhar"
                app:icon="@drawable/ic_compartilhar" />

            <Button
                android:id="@+id/btnExcluir"
                style="@style/Botao.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:layout_marginBottom="@dimen/espaco_grande"
                android:text="@string/detalhe_excluir"
                android:textColor="@color/erro"
                app:icon="@drawable/ic_lixeira"
                app:iconTint="@color/erro"
                app:strokeColor="@color/erro" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
