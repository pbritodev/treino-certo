<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espaco_medio">

        <!-- 1. Objetivo -->
        <androidx.cardview.widget.CardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/q_objetivo"
                    android:textAppearance="@style/Texto.Secao" />

                <Spinner
                    android:id="@+id/spnObjetivo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/espaco_pequeno" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. Nível -->
        <androidx.cardview.widget.CardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/q_nivel"
                    android:textAppearance="@style/Texto.Secao" />

                <RadioGroup
                    android:id="@+id/grupoNivel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbIniciante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/q_nivel_iniciante" />

                    <RadioButton
                        android:id="@+id/rbIntermediario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/q_nivel_intermediario" />

                    <RadioButton
                        android:id="@+id/rbAvancado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/q_nivel_avancado" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. Disponibilidade -->
        <androidx.cardview.widget.CardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Texto.Secao" />

                <SeekBar
                    android:id="@+id/seekDias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:max="4"
                    android:progress="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:text="@string/q_minutos"
                    android:textAppearance="@style/Texto.Secao" />

                <Spinner
                    android:id="@+id/spnMinutos"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/espaco_pequeno" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. Local -->
        <androidx.cardview.widget.CardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/q_local"
                    android:textAppearance="@style/Texto.Secao" />

                <RadioGroup
                    android:id="@+id/grupoLocal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbCasa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/q_local_casa" />

                    <RadioButton
                        android:id="@+id/rbAcademia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/q_local_academia" />

                    <RadioButton
                        android:id="@+id/rbArLivre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/q_local_ar_livre" />
                </RadioGroup>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swEquipamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:text="@string/q_equipamento"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 5. Rotina -->
        <androidx.cardview.widget.CardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/q_rotina"
                    android:textAppearance="@style/Texto.Secao" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:text="@string/q_atividade"
                    android:textAppearance="@style/Texto.Secundario" />

                <Spinner
                    android:id="@+id/spnAtividade"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />

                <TextView
                    android:id="@+id/txtSono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:textAppearance="@style/Texto.Secundario" />

                <SeekBar
                    android:id="@+id/seekSono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="9"
                    android:progress="4" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 6. Medidas -->
        <androidx.cardview.widget.CardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/q_medidas"
                    android:textAppearance="@style/Texto.Secao" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campoPeso"
                        style="@style/CampoTexto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/espaco_pequeno"
                        android:layout_weight="1"
                        android:hint="@string/q_peso"
                        app:suffixText="kg">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPeso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLength="5" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campoAltura"
                        style="@style/CampoTexto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_pequeno"
                        android:layout_weight="1"
                        android:hint="@string/q_altura"
                        app:suffixText="cm">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtAltura"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoPesoMeta"
                    style="@style/CampoTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/q_peso_meta"
                    app:helperText="@string/q_peso_meta_ajuda"
                    app:suffixText="kg">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPesoMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLength="5" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 7. Restrições -->
        <androidx.cardview.widget.CardView
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/q_restricoes"
                    android:textAppearance="@style/Texto.Secao" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/q_restricoes_desc"
                    android:textAppearance="@style/Texto.Secundario" />

                <CheckBox
                    android:id="@+id/cbJoelho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/q_restricao_joelho" />

                <CheckBox
                    android:id="@+id/cbColuna"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/q_restricao_coluna" />

                <CheckBox
                    android:id="@+id/cbOmbro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/q_restricao_ombro" />

                <CheckBox
                    android:id="@+id/cbCardiaco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/q_restricao_cardiaco" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ProgressBar
            android:id="@+id/progresso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGerarPlano"
            style="@style/Botao.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:layout_marginBottom="@dimen/espaco_grande"
            android:text="@string/q_gerar"
            app:icon="@drawable/ic_haltere" />
    </LinearLayout>
</ScrollView>
