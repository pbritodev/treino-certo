<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margem_tela">

    <TextView
        android:id="@+id/txtNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Texto.Titulo" />

    <TextView
        android:id="@+id/txtPor100g"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/Texto.Secundario" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campoQuantidade"
        style="@style/CampoTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_medio"
        android:hint="@string/diario_quantidade">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtQuantidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLength="6" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/grupoPorcoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_pequeno">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMeia"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alimento_meia_porcao" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipUma"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alimento_uma_porcao" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDuas"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alimento_duas_porcoes" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_medio"
        android:text="@string/alimento_refeicao"
        android:textAppearance="@style/Texto.Secundario" />

    <Spinner
        android:id="@+id/spnRefeicao"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <androidx.cardview.widget.CardView
        style="@style/Cartao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_pequeno"
        app:cardBackgroundColor="@color/verde_claro"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTotalKcal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/verde_primario"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMacros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/Texto.Secundario" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnAdicionar"
        style="@style/Botao.Principal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_medio"
        android:text="@string/alimento_adicionar"
        app:icon="@drawable/ic_adicionar" />
</LinearLayout>
