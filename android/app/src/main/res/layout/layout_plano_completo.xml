<?xml version="1.0" encoding="utf-8"?>
<!-- Bloco reutilizado pelas telas de Resultado e Detalhe: resumo + plano semanal + dicas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        style="@style/Cartao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgObjetivo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/fundo_chip"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    app:tint="@color/laranja" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_medio"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtPerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textColor="@color/texto_primario"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtResumo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Texto.Secundario" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtIntensidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio"
                android:textAppearance="@style/Texto.Corpo" />

            <ProgressBar
                android:id="@+id/barraIntensidade"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:max="100" />

            <TextView
                android:id="@+id/txtImc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:textAppearance="@style/Texto.Secundario" />

            <TextView
                android:id="@+id/txtMetaCalorica"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawablePadding="6dp"
                android:textAppearance="@style/Texto.Corpo"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_fogo"
                app:drawableTint="@color/laranja" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="@dimen/espaco_medio"
        android:text="@string/resultado_plano_semanal"
        android:textAppearance="@style/Texto.Secao" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:text="@string/resultado_dica_video"
        android:textAppearance="@style/Texto.Secundario" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlano"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

    <androidx.cardview.widget.CardView
        style="@style/Cartao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/verde_claro">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resultado_dicas"
                android:textAppearance="@style/Texto.Secao" />

            <TextView
                android:id="@+id/txtDicas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:lineSpacingExtra="6dp"
                android:textAppearance="@style/Texto.Corpo" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
