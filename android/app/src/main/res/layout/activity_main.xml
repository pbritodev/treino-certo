<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fundo_cabecalho"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_haltere"
                app:tint="@color/branco" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/branco"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSaudacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margem_tela"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/slogan"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/branco" />
        </LinearLayout>

        <!-- Menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espaco_medio">

            <include
                android:id="@+id/menuNovaAvaliacao"
                layout="@layout/item_menu_home" />

            <include
                android:id="@+id/menuHistorico"
                layout="@layout/item_menu_home" />

            <include
                android:id="@+id/menuPerfil"
                layout="@layout/item_menu_home" />

            <include
                android:id="@+id/menuSobre"
                layout="@layout/item_menu_home" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
