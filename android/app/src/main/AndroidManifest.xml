<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+: declara quais apps externos as Intents implícitas podem consultar -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".TreinoCertoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TreinoCerto"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.home.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.cadastro.CadastroActivity"
            android:parentActivityName=".ui.home.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.questionario.QuestionarioActivity"
            android:parentActivityName=".ui.home.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.resultado.ResultadoActivity"
            android:parentActivityName=".ui.home.MainActivity" />
        <activity
            android:name=".ui.historico.HistoricoActivity"
            android:parentActivityName=".ui.home.MainActivity" />
        <activity
            android:name=".ui.detalhe.DetalheActivity"
            android:parentActivityName=".ui.historico.HistoricoActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.diario.DiarioActivity"
            android:parentActivityName=".ui.home.MainActivity" />
        <activity
            android:name=".ui.alimento.AdicionarAlimentoActivity"
            android:parentActivityName=".ui.diario.DiarioActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.peso.PesoActivity"
            android:parentActivityName=".ui.home.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.sobre.SobreActivity"
            android:parentActivityName=".ui.home.MainActivity" />
    </application>
</manifest>
